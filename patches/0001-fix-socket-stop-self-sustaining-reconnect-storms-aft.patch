@@ -572,7 +572,16 @@
 		await initChatList();
 	};
 
+	// Each socket reconnect re-fetches the chat list, pinned chats and folders. During a reconnect storm that
+	// is several DB-backed requests per tab per reconnect, so skip refreshes that follow each other closely.
+	const RECONNECT_REFRESH_MIN_INTERVAL_MS = 15000;
+	let lastChatRowsRefreshAt = 0;
 	const refreshChatRows = async () => {
+		const now = Date.now();
+		if (chatListReady && now - lastChatRowsRefreshAt < RECONNECT_REFRESH_MIN_INTERVAL_MS) {
+			return;
+		}
+		lastChatRowsRefreshAt = now;
 		markFolderChatsDirty();
 		const result = await refreshChatList(localStorage.token, { refreshPinned: true });
 		if (result.accepted) {
diff --git a/src/routes/+layout.svelte b/src/routes/+layout.svelte
index 29fdf008..6da0cc64 100644
--- a/src/routes/+layout.svelte
+++ b/src/routes/+layout.svelte
@@ -184,14 +184,56 @@
 		});
 		await socket.set(_socket);
 
+		// Reconnect with exponential backoff and jitter instead of immediately. An immediate reconnect from
+		// thousands of tabs at once is what turns a short backend hiccup into a self-sustaining storm.
+		let reconnectAttempt = 0;
+		let reconnectTimer = null;
+		const RECONNECT_BASE_MS = 1000;
+		const RECONNECT_MAX_MS = 30000;
+		const scheduleReconnect = (why) => {
+			if (reconnectTimer || _socket.connected) {
+				return;
+			}
+			const base = Math.min(RECONNECT_MAX_MS, RECONNECT_BASE_MS * 2 ** reconnectAttempt);
+			const delay = Math.round(base * (0.5 + Math.random())); // 50%..150% of base
+			reconnectAttempt += 1;
+			console.log(`Socket reconnect (${why}) in ${delay}ms, attempt ${reconnectAttempt}`);
+			reconnectTimer = setTimeout(() => {
+				reconnectTimer = null;
+				if (!_socket.connected) {
+					_socket.connect();
+				}
+			}, delay);
+		};
+
 		_socket.on('connect_error', (err) => {
 			console.log('connect_error', err);
+			if (err?.message === 'unauthorized') {
+				// The server refused our token (expired or revoked). Sign out right here instead of relying on a
+				// later 401 + confirmation request, which fails under load and leaves the tab looping.
+				console.log('Socket refused: session is no longer valid, signing out');
+				clearExpiredSession();
+				// `auth` re-reads localStorage.token, which is now gone: the next connect is anonymous and
+				// accepted, so the login page still has a socket to emit user-join on after signing in.
+				scheduleReconnect('unauthorized');
+				return;
+			}
+			// `active` is false when the server refused the handshake (e.g. backend temporarily unavailable):
+			// socket.io does not retry those on its own, so retry here with backoff.
+			if (!_socket.active) {
+				scheduleReconnect('connect_error');
+			}
 		});
 
 		let hasConnectedOnce = false;
 
 		_socket.on('connect', async () => {
 			console.log('connected', _socket.id);
+			reconnectAttempt = 0;
+			if (reconnectTimer) {
+				clearTimeout(reconnectTimer);
+				reconnectTimer = null;
+			}
 
 			// Cancel any pending disconnect toast if we reconnected quickly
 			clearDisconnectToastTimer();
@@ -247,7 +289,17 @@
 
 			if (localStorage.getItem('token')) {
 				// Emit user-join event with auth token
-				_socket.emit('user-join', { auth: { token: localStorage.token } });
+				// Retry later if the backend could not verify the token right now
+				const emitUserJoin = (attempt = 0) => {
+					_socket.emit('user-join', { auth: { token: localStorage.token } }, (res) => {
+						if (res?.error === 'backend_unavailable' && res?.retry && attempt < 6 && _socket.connected) {
+							const delay = Math.round(Math.min(30000, 2000 * 2 ** attempt) * (0.5 + Math.random()));
+							console.log(`user-join deferred by server, retrying in ${delay}ms`);
+							setTimeout(() => emitUserJoin(attempt + 1), delay);
+						}
+					});
+				};
+				emitUserJoin();
 			} else {
 				console.warn('No token found in localStorage, user-join event not emitted');
 			}
@@ -280,7 +332,7 @@
 			}
 
 			if (reason === 'io server disconnect') {
-				_socket.connect();
+				scheduleReconnect('server disconnect');
 			}
 
 			if (details) {
@@ -926,6 +978,14 @@
 		};
 
 		window.addEventListener('message', windowMessageEventHandler);
+		// When another tab of this user signs out (token removed from localStorage), follow it instead of
+		// lingering with a stale session and an anonymous socket.
+		window.addEventListener('storage', (e) => {
+			if (e.key === 'token' && !e.newValue && $user) {
+				console.log('Token removed by another tab, signing out');
+				clearExpiredSession();
+			}
+		});
 
 		let touchstartY = 0;
 
