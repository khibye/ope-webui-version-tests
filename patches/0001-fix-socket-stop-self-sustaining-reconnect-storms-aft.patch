diff --git a/backend/open_webui/socket/main.py b/backend/open_webui/socket/main.py
index 69c21e5b..542e2859 100644
--- a/backend/open_webui/socket/main.py
+++ b/backend/open_webui/socket/main.py
@@ -67,8 +67,12 @@ from open_webui.utils.redis import (
     get_redis_connection,
     get_sentinels_from_env,
 )
+import os
 from redis.exceptions import RedisError
+from socketio.exceptions import ConnectionRefusedError as SocketConnectionRefusedError
 from socketio.packet import Packet
+from sqlalchemy.exc import SQLAlchemyError
+from starlette.exceptions import HTTPException as StarletteHTTPException
 
 logging.basicConfig(stream=sys.stdout, level=GLOBAL_LOG_LEVEL)
 log = logging.getLogger(__name__)
@@ -459,12 +463,37 @@ def get_user_id_from_session_pool(sid):
 
 LOCAL_AUTHENTICATED_SIDS: set[str] = set()
 
+# Errors that mean "the backend could not answer right now", as opposed to "the token is invalid".
+# A socket must never be disconnected because of one of these: disconnecting makes every client reconnect
+# at once, each reconnect needs the same backend to verify its token, and the resulting load keeps the
+# backend unavailable (self-sustaining reconnect storm).
+TRANSIENT_BACKEND_ERRORS = (SQLAlchemyError, RedisError, asyncio.TimeoutError, TimeoutError, ConnectionError)
+SOCKET_REAUTH_INTERVAL = max(int(os.getenv('SOCKET_REAUTH_INTERVAL', '30')), 10)
+SOCKET_REAUTH_JITTER = 15
+# A single re-verification must not wait DATABASE_POOL_TIMEOUT for a connection: a sweep over hundreds of sockets
+# with a saturated pool would then run for hours. After this many seconds the check counts as "could not verify".
+SOCKET_REAUTH_CHECK_TIMEOUT = max(float(os.getenv('SOCKET_REAUTH_CHECK_TIMEOUT', '5')), 1.0)
+# Heartbeats arrive every 30 s per socket; writing user.last_active_at on each one is one UPDATE + commit per socket
+# per 30 s. Write it at most this often per socket instead.
+HEARTBEAT_LAST_ACTIVE_WRITE_INTERVAL = max(int(os.getenv('HEARTBEAT_LAST_ACTIVE_WRITE_INTERVAL', '300')), 30)
+
+
+def is_transient_backend_error(exc: BaseException) -> bool:
+    if isinstance(exc, StarletteHTTPException):
+        # get_auth() maps database errors to 503 ("Authentication is temporarily unavailable.")
+        return exc.status_code in (502, 503, 504)
+    return isinstance(exc, TRANSIENT_BACKEND_ERRORS)
+
 
 async def periodic_socket_authentication():
     while True:
-        await asyncio.sleep(30)
+        # Jitter so that workers do not all hit the database in the same second.
+        await asyncio.sleep(SOCKET_REAUTH_INTERVAL + random.uniform(0, SOCKET_REAUTH_JITTER))
+        sweep_started = time.monotonic()
         await encryption.sweep()
-        for sid in tuple(LOCAL_AUTHENTICATED_SIDS):
+        for i, sid in enumerate(tuple(LOCAL_AUTHENTICATED_SIDS)):
+            if i % 50 == 49:
+                await asyncio.sleep(0)  # let heartbeats and requests run between checks
             session_user = await get_socket_session_user(sid)
             if session_user:
                 from open_webui.socket.comments import revalidate_comment_subscription
@@ -474,15 +503,41 @@ async def periodic_socket_authentication():
                 except Exception:
                     log.exception('Could not revalidate comment subscription')
 
+        sweep_took = time.monotonic() - sweep_started
+        if sweep_took > SOCKET_REAUTH_INTERVAL:
+            log.warning('Socket re-verification sweep took %.0fs for %d sockets (interval %ds)',
+                        sweep_took, len(LOCAL_AUTHENTICATED_SIDS), SOCKET_REAUTH_INTERVAL)
+
 
 async def get_socket_session_user(sid: str, *, wait_for_disconnect: bool = True) -> dict | None:
-    """Session user from this worker's local Socket.IO store; only locally connected sids are ever looked up."""
+    """Session user from this worker's local Socket.IO store; only locally connected sids are ever looked up.
+
+    Disconnects the socket only when the token is actually invalid. If the backend cannot be reached to
+    re-verify it, the previously verified session user is kept and the check is retried on the next sweep.
+    """
+    session = None
     try:
         session = await sio.get_session(sid)
-        if session.get('user') and await get_verified_user_by_token(session.get('token', ''), REDIS):
-            return session['user']
     except Exception:
-        log.debug('Socket authentication expired for %s', sid)
+        log.debug('No local session for %s', sid)
+
+    if session and session.get('user'):
+        try:
+            if await asyncio.wait_for(
+                get_verified_user_by_token(session.get('token', ''), REDIS), timeout=SOCKET_REAUTH_CHECK_TIMEOUT
+            ):
+                return session['user']
+            log.debug('Socket authentication expired for %s', sid)
+        except Exception as e:
+            if is_transient_backend_error(e):
+                log.warning(
+                    'Could not re-verify socket %s because the backend is unavailable (%s); keeping the session',
+                    sid,
+                    e,
+                )
+                return session['user']
+            log.debug('Socket authentication check failed for %s', sid, exc_info=True)
+
     LOCAL_AUTHENTICATED_SIDS.discard(sid)
     if wait_for_disconnect:
         await sio.disconnect(sid)
@@ -623,7 +678,22 @@ async def connect(sid, environ, auth):
         scope = (environ or {}).get('asgi.scope') or {}
         fastapi_app = scope.get('app')
         redis = getattr(getattr(fastapi_app, 'state', None), 'redis', None) or REDIS
-        user = await get_verified_user_by_token(auth['token'], redis)
+        try:
+            user = await get_verified_user_by_token(auth['token'], redis)
+        except Exception as e:
+            if not is_transient_backend_error(e):
+                raise
+            # Refuse the handshake with an explicit reason instead of letting the exception tear down the
+            # transport. The client sees a connect_error carrying this data and retries with backoff.
+            log.warning('Refusing socket %s: backend unavailable during token verification (%s)', sid, e)
+            raise SocketConnectionRefusedError('backend_unavailable', {'retry': True}) from None
+
+        if user is None and auth['token']:
+            # The token was supplied but is invalid (expired or revoked). Refuse the handshake instead of
+            # accepting an anonymous socket that every heartbeat would then disconnect, which makes the
+            # client reconnect and re-fetch the whole sidebar in a loop (a 401 storm after a mass revoke).
+            log.debug('Refusing socket %s: invalid token', sid)
+            raise SocketConnectionRefusedError('unauthorized')
 
         if user:
             socket_user = {
@@ -654,7 +724,13 @@ async def user_join(sid, data):
     scope = environ.get('asgi.scope') or {}
     fastapi_app = scope.get('app')
     redis = getattr(getattr(fastapi_app, 'state', None), 'redis', None) or REDIS
-    user = await get_verified_user_by_token(auth['token'], redis)
+    try:
+        user = await get_verified_user_by_token(auth['token'], redis)
+    except Exception as e:
+        if not is_transient_backend_error(e):
+            raise
+        log.warning('user-join for %s could not be verified: backend unavailable (%s)', sid, e)
+        return {'error': 'backend_unavailable', 'retry': True}
     if not user:
         return
 
@@ -736,15 +812,33 @@ async def refresh_chat_access(chat_id=None):
 
 @sio.on('heartbeat')
 async def heartbeat(sid, data):
-    user = await get_socket_session_user(sid)
-    if user:
+    try:
+        session = await sio.get_session(sid)
+    except Exception:
+        session = None
+    if not session or not session.get('user'):
+        # Anonymous socket (login page): nothing to refresh, and disconnecting it would only make the client
+        # reconnect and re-fetch everything.
+        return
+    user = session['user']
+    now = int(time.time())
+    try:
         SESSION_POOL[sid] = {
             **(SESSION_POOL.get(sid) or {}),
             **user,
-            'last_seen_at': int(time.time()),
+            'last_seen_at': now,
         }
-        await Users.update_last_active_by_id(user['id'])
-
+    except Exception as e:
+        log.debug('heartbeat: could not refresh session pool for %s: %s', sid, e)
+    if now - session.get('last_active_written_at', 0) >= HEARTBEAT_LAST_ACTIVE_WRITE_INTERVAL:
+        try:
+            await Users.update_last_active_by_id(user['id'])
+            session['last_active_written_at'] = now
+            await sio.save_session(sid, session)
+        except Exception as e:
+            if not is_transient_backend_error(e):
+                raise
+            log.debug('heartbeat: could not update last_active_at for %s: %s', sid, e)
 
 @sio.on('join-channels')
 async def join_channel(sid, data):
diff --git a/src/lib/components/layout/Sidebar.svelte b/src/lib/components/layout/Sidebar.svelte
